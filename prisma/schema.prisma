// Prisma Schema for CafeCircle
// Community-powered cafe funding and growth platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String    @default("password123")
  role          String    @default("CUSTOMER") // INVESTOR, CAFE_OWNER, CUSTOMER, ADMIN
  avatar        String?
  phone         String?
  bio           String?
  referralCode  String    @unique @default(cuid())
  city          String?   @default("Bengaluru")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cafeOwner     CafeOwner?
  investor      Investor?
  notifications Notification[]
  reviews       Review[]
  transactions  Transaction[]
  referrals     Referral[]
}

model CafeOwner {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  businessPan        String?
  gstNumber          String?
  isVerified         Boolean   @default(false)
  verificationStatus String    @default("VERIFIED") // PENDING, VERIFIED, REJECTED
  bankAccountDetails String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cafes              Cafe[]
}

model Cafe {
  id                   String            @id @default(cuid())
  ownerId              String
  owner                CafeOwner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String            @unique
  tagline              String
  description          String
  story                String?
  logo                 String
  coverImage           String
  images               String            @default("[]") // JSON string array of URLs
  address              String
  city                 String
  state                String            @default("Karnataka")
  pincode              String?
  establishedYear      Int               @default(2021)
  currentBranchesCount Int               @default(1)
  website              String?
  instagram            String?
  rating               Float             @default(4.8)
  reviewCount          Int               @default(42)
  cuisine              String            @default("Specialty Coffee & Bakes")
  openingHours         String            @default("10:00 AM – 11:00 PM")
  isOpen               Boolean           @default(true)
  priceForTwo          String            @default("₹800 for two")
  dataSource           String            @default("Community Seed Listing (Ghaziabad / Delhi NCR)")
  isVerified           Boolean           @default(true)
  verificationBadge    String            @default("VERIFIED_COMMUNITY_CAFE")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  branches             CafeBranch[]
  campaigns            Campaign[]
  businessUpdates      BusinessUpdate[]
  financialReports     FinancialReport[]
  documents            Document[]
  reviews              Review[]
  referrals            Referral[]
}

model CafeBranch {
  id              String    @id @default(cuid())
  cafeId          String
  cafe            Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  name            String
  address         String
  city            String
  status          String    @default("OPERATING") // OPERATING, UPCOMING, PLANNED
  openingDate     DateTime?
  seatingCapacity Int       @default(45)
  monthlyFootfall Int       @default(3200)
  createdAt       DateTime  @default(now())
}

model Campaign {
  id                 String               @id @default(cuid())
  cafeId             String
  cafe               Cafe                 @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  title              String
  slug               String               @unique
  pitch              String
  reasonForFunding   String
  expansionPlan      String
  targetAmount       Float
  raisedAmount       Float                @default(0)
  minInvestment      Float                @default(5000)
  maxInvestment      Float                @default(100000)
  startDate          DateTime             @default(now())
  endDate            DateTime
  status             String               @default("ACTIVE") // DRAFT, ACTIVE, FUNDED, COMPLETED
  investmentStructure String              @default("REVENUE_SHARE") // REVENUE_SHARE, STORE_CREDIT_PERKS, HYBRID_GROWTH
  returnTerms        String               // Details of return/perk model
  riskFactors        String               // Disclosed risks
  pitchDeckUrl       String?
  financialAuditUrl  String?
  investorCount      Int                  @default(0)
  projectedReturnRate String              @default("12% - 16% p.a. (Simulated)")
  repaymentPeriod    String               @default("24 - 36 Months")
  expansionCity      String               @default("Bengaluru")
  expansionArea      String               @default("Indiranagar")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  investments        Investment[]
}

model Investor {
  id                     String       @id @default(cuid())
  userId                 String       @unique
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycStatus              String       @default("VERIFIED") // PENDING, VERIFIED
  totalInvested          Float        @default(0)
  totalReturnsReceived   Float        @default(0)
  activeInvestmentsCount Int          @default(0)
  ambassadorTier         String       @default("Bronze Patron") // Bronze, Silver, Gold, Espresso Patron
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  investments            Investment[]
}

model Investment {
  id                  String               @id @default(cuid())
  campaignId          String
  campaign            Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  investorId          String
  investor            Investor             @relation(fields: [investorId], references: [id], onDelete: Cascade)
  amount              Float
  status              String               @default("CONFIRMED") // PENDING, CONFIRMED, CANCELLED
  certificateNumber   String               @unique
  paymentMethod       String               @default("UPI_SIMULATED")
  paymentReference    String               @default("TXN_SIM_001")
  returnsAccrued      Float                @default(0)
  isSimulated         Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  agreement           InvestmentAgreement?
  transactions        Transaction[]
}

model InvestmentAgreement {
  id                 String     @id @default(cuid())
  investmentId       String     @unique
  investment         Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  agreementNumber    String     @unique
  termSheetSnapshot  String     // Summary of agreed terms
  signedAt           DateTime   @default(now())
  termsAccepted      Boolean    @default(true)
  pdfUrl             String?
  status             String     @default("ACTIVE")
  createdAt          DateTime   @default(now())
}

model Transaction {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentId String?
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  type         String      // INVESTMENT_SIMULATED, RETURN_PAYOUT, REWARD_CREDIT
  amount       Float
  status       String      @default("COMPLETED") // PENDING, COMPLETED, FAILED
  referenceId  String      @unique
  notes        String?
  isSimulated  Boolean     @default(true)
  createdAt    DateTime    @default(now())
}

model Referral {
  id               String               @id @default(cuid())
  referrerId       String
  referrer         User                 @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  cafeId           String
  cafe             Cafe                 @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  referralCode     String               @unique
  totalClicks      Int                  @default(0)
  totalVisits      Int                  @default(0)
  totalConversions Int                  @default(0)
  totalShares      Int                  @default(0)
  advocatePoints   Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  conversions      ReferralConversion[]
}

model ReferralConversion {
  id             String    @id @default(cuid())
  referralId     String
  referral       Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  visitorName    String
  visitorEmail   String?
  conversionType String    @default("CAFE_VISIT") // CAFE_VISIT, NEW_SIGNUP, INVESTMENT
  rewardCredits  Float     @default(50) // Store credit / reward points
  verifiedAt     DateTime  @default(now())
}

model BusinessUpdate {
  id           String    @id @default(cuid())
  cafeId       String
  cafe         Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  title        String
  content      String
  images       String    @default("[]") // JSON string array
  milestoneTag String    @default("Expansion") // Expansion, Interior, Licensing, Grand Opening, Menu Launch
  isPublic     Boolean   @default(true)
  authorRole   String    @default("Founder & Head Roaster")
  createdAt    DateTime  @default(now())
}

model FinancialReport {
  id               String    @id @default(cuid())
  cafeId           String
  cafe             Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  month            String    // e.g. "October"
  year             Int       // e.g. 2026
  grossRevenue     Float     // e.g. 740000
  netProfit        Float     // e.g. 165000
  customerFootfall Int       // e.g. 4800
  reportPdfUrl     String?
  notes            String?
  isVerified       Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // INVESTMENT, UPDATE, REFERRAL, SYSTEM, MILESTONE
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  cafeId      String
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  title       String
  docType     String   // PAN, GST, FSSAI_LICENSE, FINANCIAL_AUDIT, PITCH_DECK, LEASE_AGREEMENT
  fileUrl     String
  fileSize    String   @default("2.4 MB")
  isVerified  Boolean  @default(true)
  uploadedAt  DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  cafeId     String
  cafe       Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Float    @default(5.0)
  comment    String
  isInvestor Boolean  @default(false)
  createdAt  DateTime @default(now())
}
